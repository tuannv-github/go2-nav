<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS>
  <Domain id="any">
    <General>
      <Interfaces>
        <!-- Prefer robot link on eth0, keep wlan0 and usb1 available -->
        <NetworkInterface name="eth0" priority="3" multicast="default" />
        <NetworkInterface name="wlan0" priority="2" multicast="default" />
        <NetworkInterface name="usb1" priority="1" multicast="default" />
      </Interfaces>
    </General>
    <Discovery>
      <Peers>
        <!-- Point to server -->
        <Peer address="10.1.108.250"/>
        <Peer address="10.1.100.139"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
