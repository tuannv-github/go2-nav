<?xml version="1.0" encoding="UTF-8"?>
<!-- Nav2 / RTAB-Map: advertise on wlan0 for remote PCs, keep eth0 for local /odom.
     (eth0-only odom must stay off wlan0 — see cyclonedds.odom.xml.) -->
<CycloneDDS>
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="wlan0" priority="2" multicast="default" presence_required="false" />
        <NetworkInterface name="lo" priority="1" multicast="true" />
        <NetworkInterface name="eth0" priority="1" multicast="default" />
      </Interfaces>
    </General>
    <Discovery>
      <Peers>
        <Peer address="10.1.100.220"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
