<?xml version="1.0" encoding="UTF-8"?>
<!-- Realsense Video Publisher: strictly local loopback (lo) only.
     Completely independent of Wi-Fi / Ethernet state. -->
<CycloneDDS>
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" priority="1" multicast="true" />
      </Interfaces>
    </General>
  </Domain>
</CycloneDDS>
