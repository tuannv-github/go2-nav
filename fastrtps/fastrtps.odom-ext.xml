<?xml version="1.0" encoding="UTF-8" ?>
<!-- Template: @WLAN_IP@ / @PEER_IP@ rewritten into /tmp/fastrtps.odom-ext.xml.
     Whitelist lo+wlan so on-robot /reset survives DHCP; skip eth0 (192.168.123.18). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>odom_ext_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>@WLAN_IP@</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="odom_ext" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>odom_ext_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <discovery_config>
          <discoveryProtocol>SIMPLE</discoveryProtocol>
          <leaseDuration>
            <sec>10</sec>
            <nanosec>0</nanosec>
          </leaseDuration>
          <leaseAnnouncement>
            <sec>1</sec>
            <nanosec>0</nanosec>
          </leaseAnnouncement>
          <initialAnnouncements>
            <count>20</count>
            <period>
              <sec>0</sec>
              <nanosec>50000000</nanosec>
            </period>
          </initialAnnouncements>
        </discovery_config>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>@PEER_IP@</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
