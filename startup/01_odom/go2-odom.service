[Unit]
Description=Go2 utlidar odom bridge (/utlidar/robot_odom -> /odom)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/go2-nav
Environment=HOME=/home/unitree
Environment=ROS_DOMAIN_ID=0
ExecStart=/home/unitree/go2-nav/startup/01_odom/run_odom.sh
Restart=always
RestartSec=5
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
